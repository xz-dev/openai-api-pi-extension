{
  "name": "openai-api-pi-extension",
  "version": "0.2.0",
  "description": "Minimal modern Pi provider extension for any OpenAI-compatible gateway using the Responses API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/openai-api-pi-extension.git"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "responses-api"
  ],
  "type": "module",
  "scripts": {
    "check": "node --check index.ts && npm run test",
    "test": "node --import ./tests/fixtures/request-compression-preload.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@opencode-ai/models": "*",
    "minimatch": "10.2.6",
    "modelparams": "*",
    "openai": "7.45.1",
    "semver": "^7.8.5",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.2 || ^1.0.0",
    "@earendil-works/pi-coding-agent": "^0.84.2 || ^1.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/ws": "^8.18.1"
  }
}
